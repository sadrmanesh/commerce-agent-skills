{
  "name": "@sadrmanesh/commerce-agent-skills",
  "version": "0.3.1",
  "description": "Tool-agnostic skills and rules for AI coding agents that build e-commerce and marketplace products.",
  "keywords": [
    "agent-skills",
    "skills",
    "ecommerce",
    "woocommerce",
    "shopify",
    "stripe",
    "marketplace",
    "coding-agents",
    "rules",
    "cli"
  ],
  "license": "MIT",
  "author": "Naser Sadrmanesh <info.sadrmanesh@gmail.com>",
  "type": "module",
  "bin": {
    "commerce-agent-skills": "./bin/commerce-agent-skills.mjs"
  },
  "files": [
    "bin",
    "skills",
    "rules",
    "scripts/lib/frontmatter.mjs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "catalog": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "docs": "node scripts/build-docs.mjs && mkdocs build --strict -f build/mkdocs.yml",
    "test": "node --test",
    "eval": "node scripts/run-evals.mjs",
    "prepublishOnly": "node scripts/validate-skills.mjs && node scripts/generate-catalog.mjs --check && node --test",
    "pack:check": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadrmanesh/commerce-agent-skills.git"
  },
  "homepage": "https://sadrmanesh.github.io/commerce-agent-skills/",
  "bugs": {
    "url": "https://github.com/sadrmanesh/commerce-agent-skills/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
